+bool KodoTerm::continuesRow(int row) const {
+    int history=visibleHistorySize();
+    if(row<history)return row>=0 && m_scrollback[row].continuation;
+    int rows,cols;vterm_get_size(m_vterm,&rows,&cols);
+    if(row-history>=rows)return false;
+    return vterm_state_get_lineinfo(vterm_obtain_state(m_vterm),row-history)->continuation;
+}
