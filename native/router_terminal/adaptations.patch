+QString KodoTerm::linkAt(const QPoint &point) {
+    auto pos=mouseToPos(point);int rows,cols;vterm_get_size(m_vterm,&rows,&cols);
+    int total=visibleHistorySize()+rows;
+    if(pos.row<0 || pos.row>=total)return {};
+    int first=pos.row,last=pos.row;
+    while(first>0 && continuesRow(first) && pos.row-first<128)--first;
+    while(last+1<total && continuesRow(last+1) && last-pos.row<128)++last;
+    QString line=getTextRange({first,0},{last,cols-1});
+    int offset=getTextRange({first,0},pos).size()-1;
+    QRegularExpression pattern(QStringLiteral("https?://[^\\s<>\"']+"));
+    auto matches=pattern.globalMatch(line);
+    while(matches.hasNext()) {
+        auto match=matches.next();
+        if(offset>=match.capturedStart() && offset<match.capturedEnd())return match.captured();
+    }
+    return {};
+}
+bool KodoTerm::findNext(const QString &needle) {
+    if(needle.isEmpty())return false;
+    int rows,cols;vterm_get_size(m_vterm,&rows,&cols);
+    int total=visibleHistorySize()+rows;
+    int first=hasSelection()?m_selectionEnd.row:0;
+    while(first>0 && continuesRow(first))--first;
+    for(int count=0;count<=total;++count) {
+        int row=(first+count)%total;
+        if(row>0 && continuesRow(row))continue;
+        int last=row;
+        while(last+1<total && continuesRow(last+1))++last;
+        QString line=getTextRange({row,0},{last,cols-1});
+        int from=(count==0 && hasSelection())?getTextRange({row,0},m_selectionEnd).size():0;
+        int index=line.indexOf(needle,from,Qt::CaseInsensitive);
+        if(index<0)continue;
+        int offset=0;VTermPos start={row,0},end={row,0};bool found=false;
+        for(int r=row;r<=last && !found;++r)for(int c=0;c<cols;++c) {
+            QString cell=getTextRange({r,c},{r,c});
+            if(cell.isEmpty())continue;
+            if(offset<=index)start={r,c};
+            offset+=cell.size();
+            if(offset>=index+needle.size()) {
+                int finalColumn=c;
+                if(c+1<cols && getTextRange({r,c+1},{r,c+1}).isEmpty())++finalColumn;
+                end={r,finalColumn};found=true;break;
+            }
+        }
+        m_selectionStart=start;m_selectionEnd=end;
+        m_scrollBar->setValue(qBound(0,start.row,m_scrollBar->maximum()));damageAll();return true;
+    }
