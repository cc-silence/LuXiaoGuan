/* Main-window frame only; settings rules stay on the settings frame. */
#settingsWindowFrame {
	background-color: rgb(245, 246, 250);
	border: 1px solid #cfd8e3;
	border-radius: 8px;
}

#settingsTitleBar {
	background-color: #FFFFFF;
	border-bottom: 1px solid #E5E7EB;
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
}

#settingsWindowTitle {
	background-color: transparent;
	border: none;
	color: #333333;
	font: 12pt "Microsoft YaHei", "Segoe UI Semibold";
}

#settingsTitleButtons {
	background-color: transparent;
	border: none;
}

#settingsTitleButtons QPushButton#settingsCloseBtn {
	background-color: transparent;
	background-image: none;
	background-position: center;
	background-repeat: no-repeat;
	border: none;
	border-radius: 5px;
	padding: 0px;
	margin: 0px;
	min-width: 28px;
	max-width: 28px;
	min-height: 28px;
	max-height: 28px;
}

#settingsTitleButtons QPushButton#settingsCloseBtn:hover {
	background-color: #F0F2F5;
	background-image: none;
	background-position: center;
	background-repeat: no-repeat;
	border: none;
	border-radius: 4px;
}

#settingsTitleButtons QPushButton#settingsCloseBtn:pressed {
	background-color: #E5E7EB;
	background-image: none;
	background-position: center;
	background-repeat: no-repeat;
	border: none;
	border-radius: 4px;
}


#settingsTitleButtons QPushButton { background: transparent; background-image: none; border: none; border-radius: 5px; padding: 0; margin: 0; min-width: 28px; max-width: 28px; min-height: 28px; max-height: 28px; }
#settingsTitleButtons QPushButton:hover { background-color: #e2e8f0; }
#settingsTitleButtons QPushButton:pressed { background-color: #d6e0ed; }

#routerMainLogo { background: transparent; border: none; }
#leftMenuBg { border-top-left-radius: 0px; }

#routerEmbeddedSettings { background: #f5f6fa; border: none; border-radius: 0px; }
#routerMainLogo { border-right: 1px solid #e5e7eb; }
