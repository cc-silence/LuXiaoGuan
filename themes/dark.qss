QWidget{
	color: #f1f3f5;
}

QLabel#floatingFeedback {
	background: transparent;
	font-weight: 700;
}
QLabel#floatingFeedback[feedbackKind="success"] { color: #66d9a3; }
QLabel#floatingFeedback[feedbackKind="cancel"] { color: #aeb8c6; }
QLabel#floatingFeedback[feedbackLayout="banner"] {
    color: #e7f0f8;
    background: #26313c;
    border: 1px solid #4c6275;
    border-radius: 6px;
    padding: 9px 20px;
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
Tooltip */
QToolTip {
	font: 11pt "Microsoft YaHei", "Segoe UI";
	color: #f4f6f8;
	background-color: #15181c;
	border: 1px solid #343b45;
	border-radius: 4px;
	padding: 0;
	margin: 0;
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
Bg App */
#bgApp {	
	background-color: #14171a;
	border: 1px solid #343A46;
	border-radius: 8px;
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
Left Menu */
#leftMenuBg {	
	background-color: #101214;
	border-top-left-radius: 8px;
	border-bottom-left-radius: 8px;
}
#topLogo {
	background-color: #101214;
}
#titleLeftApp { font: 63 12pt "Segoe UI Semibold"; }
#titleLeftDescription { font: 8pt "Segoe UI"; color: rgb(0, 120, 212); }

/* 主侧栏按钮使用 setIcon()；折叠时仅隐藏文字，不再通过背景图裁切图标。 */
#topMenu QPushButton, #bottomMenu QPushButton, #toggleButton {
	background-color: transparent;
	border: none;
	border-radius: 6px;
	color: #aeb6c2;
	text-align: center;
	margin: 3px 6px;
	padding: 0;
}
#topMenu QPushButton:hover, #bottomMenu QPushButton:hover, #toggleButton:hover {
	background-color: #24282e;
}
#topMenu QPushButton:pressed, #bottomMenu QPushButton:pressed, #toggleButton:pressed {
	background-color: rgb(0, 120, 212);
	color: rgb(255, 255, 255);
}
#topMenu QPushButton[sidebarSelected="true"], #bottomMenu QPushButton[sidebarSelected="true"] {
	background-color: #30343A;
	color: #F1F3F5;
}
QLabel[sidebarMenuText="true"] {
	background: transparent;
	color: #aeb6c2;
}
QLabel[sidebarMenuText="true"][sidebarSelected="true"] {
	color: #F1F3F5;
}
#leftMenuFrame{
	border-top: 1px solid #272c32;
}

/* Title Menu */
#titleRightInfo { padding-left: 10px; }


/* /////////////////////////////////////////////////////////////////////////////////////////////////
Extra Tab */
#extraLeftBox {	
	background-color: #171a1e;
}
#extraTopBg{	
	background-color: rgb(0, 120, 212)
}

/* Icon */
#extraIcon {
	background-position: center;
	background-repeat: no-repeat;
	background-image: url(:/icons/images/icons/icon_settings.png);
}

/* Label */
#extraLabel { color: rgb(255, 255, 255); }

/* Btn Close */
#extraCloseColumnBtn { background-color: rgba(255, 255, 255, 0); border: none;  border-radius: 5px; }
#extraCloseColumnBtn:hover { background-color: #26364c; border-style: solid; border-radius: 4px; }
#extraCloseColumnBtn:pressed { background-color: #1d2a3c; border-style: solid; border-radius: 4px; }

/* Extra Content */
#extraContent{
	border-top: 1px solid #272c32;
}

/* Extra Top Menus */
#extraTopMenu .QPushButton {
background-position: left center;
    background-repeat: no-repeat;
	border: none;
	border-left: 22px solid transparent;
	background-color:transparent;
	text-align: left;
	padding-left: 44px;
}
#extraTopMenu .QPushButton:hover {
	background-color: #24282e;
}
#extraTopMenu .QPushButton:pressed {	
	background-color: rgb(0, 120, 212);
	color: rgb(255, 255, 255);
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
Content App */
#contentTopBg{	
	background-color: #14171a;
	border-top-right-radius: 8px;
}
#contentBottom{
	border-top: 1px solid #2a2f36;
}

/* Top Buttons */
#rightButtons .QPushButton { background-color: rgba(255, 255, 255, 0); border: none;  border-radius: 5px; }
#rightButtons .QPushButton:hover { background-color: #24282e; border-style: solid; border-radius: 4px; }
#rightButtons .QPushButton:pressed { background-color: #111315; border-style: solid; border-radius: 4px; }

/* Theme Settings */
#extraRightBox { background-color: #171a1e; }
#themeSettingsTopDetail { background-color: rgb(0, 120, 212); }

/* Bottom Bar */
#bottomBar { background-color: #171a1e; 	border-bottom-right-radius: 8px; }
#bottomBar QLabel { font-size: 11px; color: #8f9aaa; padding-left: 10px; padding-right: 10px; padding-bottom: 2px; }

/* CONTENT SETTINGS */
/* MENUS */
#contentSettings .QPushButton {	
	background-position: left center;
    background-repeat: no-repeat;
	border: none;
	border-left: 22px solid transparent;
	background-color:transparent;
	text-align: left;
	padding-left: 44px;
}
#contentSettings .QPushButton:hover {
	background-color: #24282e;
}
#contentSettings .QPushButton:pressed {	
	background-color: rgb(0, 120, 212);
	color: rgb(255, 255, 255);
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
QTableWidget */
QTableWidget {	
	background-color: transparent;
	padding: 10px;
	border-radius: 5px;
	gridline-color: #2a2f36;
	border-bottom: 1px solid #2a2f36;
}
QTableWidget::item{
	border-color: #2a2f36;
	padding-left: 5px;
	padding-right: 5px;
	gridline-color: #2a2f36;
}
QTableWidget::item:selected{
	background-color: #26364c;
}
QHeaderView::section{
	background-color: #20242a;
	max-width: 30px;
	border: 1px solid #2a2f36;
	border-style: none;
    border-bottom: 1px solid #2a2f36;
    border-right: 1px solid #2a2f36;
}
QTableWidget::horizontalHeader {	
	background-color: #20242a;
}
QHeaderView::section:horizontal
{
    border: 1px solid #20242a;
	background-color: #20242a;
	padding: 3px;
	border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}
QHeaderView::section:vertical
{
    border: 1px solid #2a2f36;
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
LineEdit */
QLineEdit {
	background-color: #15181c;
	border-radius: 5px;
	border: 1px solid #2d333b;
	padding-left: 10px;
	selection-color: rgb(255, 255, 255);
	selection-background-color: rgb(50, 80, 90);
}
QLineEdit:hover {
	border: 1px solid #3b4552;
}
QLineEdit:focus {
	border: 1px solid #0078d4;
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
PlainTextEdit */
QPlainTextEdit {
	background-color: #15181c;
	border: 1px solid #2d333b;
	border-radius: 5px;
	padding: 10px;
	selection-color: rgb(255, 255, 255);
	selection-background-color: rgb(50, 80, 90);
}
QPlainTextEdit  QScrollBar:vertical {
    width: 8px;
 }
QPlainTextEdit  QScrollBar:horizontal {
    height: 8px;
 }
QPlainTextEdit:hover {
	border: 1px solid #3b4552;
}
QPlainTextEdit:focus {
	border: 1px solid #0078d4;
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
ScrollBars */
QScrollBar:horizontal {
    border: none;
    background: #1a1e23;
    height: 8px;
    margin: 0px 21px 0 21px;
	border-radius: 0px;
}
QScrollBar::handle:horizontal {
    background: rgb(0, 120, 212);
    min-width: 25px;
	border-radius: 4px
}
QScrollBar::add-line:horizontal {
    border: none;
    background: #22272e;
    width: 20px;
	border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    subcontrol-position: right;
    subcontrol-origin: margin;
}
QScrollBar::sub-line:horizontal {
    border: none;
    background: #22272e;
    width: 20px;
	border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}
QScrollBar::up-arrow:horizontal, QScrollBar::down-arrow:horizontal
{
     background: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal
{
     background: none;
}
 QScrollBar:vertical {
	border: none;
    background: #1a1e23;
    width: 8px;
    margin: 21px 0 21px 0;
	border-radius: 0px;
 }
 QScrollBar::handle:vertical {	
	background: rgb(0, 120, 212);
    min-height: 25px;
	border-radius: 4px
 }
 QScrollBar::add-line:vertical {
     border: none;
    background: #22272e;
     height: 20px;
	border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
     subcontrol-position: bottom;
     subcontrol-origin: margin;
 }
 QScrollBar::sub-line:vertical {
	border: none;
    background: #22272e;
     height: 20px;
	border-top-left-radius: 4px;
    border-top-right-radius: 4px;
     subcontrol-position: top;
     subcontrol-origin: margin;
 }
 QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
     background: none;
 }

 QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
     background: none;
 }

/* /////////////////////////////////////////////////////////////////////////////////////////////////
RadioButton */
QRadioButton::indicator {
    border: 2px solid #3a414b;
	width: 15px;
	height: 15px;
	border-radius: 10px;
    background: #181b1f;
}
QRadioButton::indicator:hover {
    border: 2px solid #4a5562;
}
QRadioButton::indicator:checked {
    background: #8fc5ee;
	border: 2px solid #7eaed2;	
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
ComboBox */
QComboBox{
	background-color: #15181c;
	border-radius: 5px;
	border: 1px solid #2d333b;
	padding: 5px;
	padding-left: 10px;
}
QComboBox:hover{
	border: 1px solid #3b4552;
}
QComboBox::drop-down {
	subcontrol-origin: padding;
	subcontrol-position: top right;
	width: 25px; 
	border-left-width: 3px;
	border-left-color: #2d333b;
	border-left-style: solid;
	border-top-right-radius: 3px;
	border-bottom-right-radius: 3px;	
	background-image: url(:/icons/images/icons/cil-arrow-bottom.png);
	background-position: center;
	background-repeat: no-reperat;
 }

/* /////////////////////////////////////////////////////////////////////////////////////////////////
Sliders */
QSlider::groove:horizontal {
    border-radius: 5px;
    height: 10px;
	margin: 0px;
	background-color: rgb(52, 59, 72);
	background-color: #242a31;
}
QSlider::groove:horizontal:hover {
	background-color: #2b323a;
}
QSlider::handle:horizontal {
    background-color: rgb(0, 120, 212);
    border: none;
    height: 10px;
    width: 10px;
    margin: 0px;
	border-radius: 5px;
}
QSlider::handle:horizontal:hover {
    background-color: rgb(0, 140, 232);
}
QSlider::handle:horizontal:pressed {
    background-color: rgb(0, 120, 212);
}

QSlider::groove:vertical {
    border-radius: 5px;
    width: 10px;
    margin: 0px;
	background-color: #242a31;
}
QSlider::groove:vertical:hover {
	background-color: #2b323a;
}
QSlider::handle:vertical {
    background-color: rgb(0, 120, 212);
	border: none;
    height: 10px;
    width: 10px;
    margin: 0px;
	border-radius: 5px;
}
QSlider::handle:vertical:hover {
    background-color: rgb(0, 140, 232);
}
QSlider::handle:vertical:pressed {
    background-color: rgb(0, 120, 212);
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
CommandLinkButton */
QCommandLinkButton {	
	color: rgb(0, 120, 212);
	border-radius: 5px;
	padding: 5px;
}
QCommandLinkButton:hover {	
	color: rgb(170, 200, 255);
	background-color: #24282e;
}
QCommandLinkButton:pressed {	
	color: rgb(0, 120, 212);
	background-color: #1a1e23;
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
Button */
#pagesContainer QPushButton {
	border: 1px solid #343b45;
	border-radius: 5px;	
	background-color: #272c33;
}
#pagesContainer QPushButton:hover {
	background-color: #313842;
	border: 1px solid #4a5664;
}
#pagesContainer QPushButton:pressed {	
	background-color: #1a1e23;
	border: 1px solid #2d333b;
}
