QSpinBox, QDoubleSpinBox { background: #15181c; color: #f1f3f5; border: 1px solid #343b45; border-radius: 5px; min-height: 28px; padding: 2px 22px 2px 8px; }
QSpinBox:focus, QDoubleSpinBox:focus { border-color: #1687e0; }
QSpinBox:disabled, QDoubleSpinBox:disabled { background: #111315; border-color: #2a2f36; color: #8f9aaa; }

QSpinBox::up-button,
QDoubleSpinBox::up-button {
	subcontrol-origin: border;
	subcontrol-position: top right;
	width: 20px;
	border: 1px solid #343b45;
	border-left: 1px solid #343b45;
	border-bottom: 1px solid #343b45;
	background-color: #1e232a;
	border-top-right-radius: 3px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
	subcontrol-origin: border;
	subcontrol-position: bottom right;
	width: 20px;
	border: 1px solid #343b45;
	border-left: 1px solid #343b45;
	border-top: 1px solid #343b45;
	background-color: #1e232a;
	border-bottom-right-radius: 3px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
	background-color: #2a313b;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
	image: url(:/icons/images/icons/cil-caret-top.png);
	width: 10px;
	height: 10px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
	image: url(:/icons/images/icons/cil-caret-bottom.png);
	width: 10px;
	height: 10px;
}
