/* /////////////////////////////////////////////////////////////////////////////////////////////////
LIGHT THEME - Clean White + Blue Accent
/////////////////////////////////////////////////////////////////////////////////////////////// */

QWidget{
	color: #333333;
}

QLabel#floatingFeedback {
	background: transparent;
	font-weight: 700;
}
QLabel#floatingFeedback[feedbackKind="success"] { color: #07884d; }
QLabel#floatingFeedback[feedbackKind="cancel"] { color: #596579; }
QLabel#floatingFeedback[feedbackLayout="banner"] {
    color: #163450;
    background: #eaf4ff;
    border: 1px solid #9bc8ee;
    border-radius: 6px;
    padding: 9px 20px;
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
Tooltip */
QToolTip {
	font: 11pt "Microsoft YaHei", "Segoe UI";
	color: #172033;
	background-color: #ffffff;
	border: 1px solid #c5cfde;
	border-radius: 4px;
	padding: 0;
	margin: 0;
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
Bg App */
#bgApp {	
	background-color: #F5F7FA;
	border: 1px solid #E5E7EB;
    color: #333333;
	border-radius: 8px;
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
Left Menu */
#leftMenuBg {	
	background-color: #FFFFFF;
	border-right: 1px solid #E5E7EB;
	border-top-left-radius: 8px;
	border-bottom-left-radius: 8px;
}
#topLogo {
	background-color: #FFFFFF;
}
#titleLeftApp { font: 63 12pt "Segoe UI Semibold"; color: #1a1a2e; }
#titleLeftDescription { font: 8pt "Segoe UI"; color: #0078d4; }

/* 主侧栏按钮使用 setIcon()；折叠时仅隐藏文字，不再通过背景图裁切图标。 */
#topMenu QPushButton, #bottomMenu QPushButton, #toggleButton {
	background-color: transparent;
	border: none;
	border-radius: 6px;
	color: #555555;
	text-align: center;
	margin: 3px 6px;
	padding: 0;
}
#topMenu QPushButton:hover, #bottomMenu QPushButton:hover, #toggleButton:hover {
	background-color: #F0F2F5;
}
#topMenu QPushButton:pressed, #bottomMenu QPushButton:pressed, #toggleButton:pressed {
	background-color: #E8F2FC;
	color: #0078d4;
}
#topMenu QPushButton[sidebarSelected="true"], #bottomMenu QPushButton[sidebarSelected="true"] {
	background-color: #E8F2FC;
	color: #155B91;
}
QLabel[sidebarMenuText="true"] {
	background: transparent;
	color: #555555;
}
QLabel[sidebarMenuText="true"][sidebarSelected="true"] {
	color: #155B91;
}
#leftMenuFrame{
	border-top: 1px solid #E5E7EB;
}

/* Title Menu */
#titleRightInfo { padding-left: 10px; }


/* /////////////////////////////////////////////////////////////////////////////////////////////////
Extra Tab */
#extraLeftBox {	
	background-color: #FFFFFF;
	border-right: 1px solid #E5E7EB;
    color: #333333;
}
#extraTopBg{	
	background-color: #FFFFFF;
	border-bottom: 1px solid #E5E7EB;
}

/* Icon */
#extraIcon {
	background-position: center;
	background-repeat: no-repeat;
	background-image: url(:/icons/images/icons/icon_settings.png);
}

/* Label */
#extraLabel { color: #333333; }

/* Btn Close */
#extraCloseColumnBtn { background-color: rgba(255, 255, 255, 0); border: none;  border-radius: 5px; }
#extraCloseColumnBtn:hover { background-color: #F0F2F5; border-style: solid; border-radius: 4px; }
#extraCloseColumnBtn:pressed { background-color: #E5E7EB; border-style: solid; border-radius: 4px; }

/* Extra Content */
#extraContent{
	border-top: 1px solid #E5E7EB;
}

/* Extra Top Menus */
#extraTopMenu .QPushButton {
    background-position: left center;
    background-repeat: no-repeat;
	border: none;
	border-left: 22px solid transparent;
	background-color:transparent;
	text-align: left;
	padding-left: 44px;
    color: #555555;
}
#extraTopMenu .QPushButton:hover {
	background-color: #F0F2F5;
}
#extraTopMenu .QPushButton:pressed {	
	background-color: #E8F2FC;
	color: #0078d4;
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
Content App */
#contentTopBg{	
	background-color: #FFFFFF;
	border-top-right-radius: 8px;
	border-bottom: 1px solid #E5E7EB;
}
#contentBottom{
	border-top: 1px solid #E5E7EB;
}
#titleRightInfo{
    color: #333333;
}

/* Top Buttons */
#rightButtons .QPushButton { background-color: rgba(255, 255, 255, 0); border: none;  border-radius: 5px; }
#rightButtons .QPushButton:hover { background-color: #F0F2F5; border-style: solid; border-radius: 4px; }
#rightButtons .QPushButton:pressed { background-color: #E5E7EB; border-style: solid; border-radius: 4px; }

/* Theme Settings */
#extraRightBox { background-color: #FFFFFF; border-left: 1px solid #E5E7EB; }
#themeSettingsTopDetail { background-color: #0078d4; }

/* Bottom Bar */
#bottomBar { background-color: #F0F2F5; border-bottom-right-radius: 8px; border-top: 1px solid #E5E7EB; }
#bottomBar QLabel { font-size: 11px; color: #888888; padding-left: 10px; padding-right: 10px; padding-bottom: 2px; }

/* CONTENT SETTINGS */
/* MENUS */
#contentSettings .QPushButton {
    background-position: left center;
    background-repeat: no-repeat;
	border: none;
	border-left: 22px solid transparent;
	background-color:transparent;
	text-align: left;
	padding-left: 44px;
    color: #555555;
}
#contentSettings .QPushButton:hover {
	background-color: #F0F2F5;
}
#contentSettings .QPushButton:pressed {	
	background-color: #E8F2FC;
	color: #0078d4;
}
/* /////////////////////////////////////////////////////////////////////////////////////////////////
QTableWidget */
QTableWidget {	
	background-color: #FFFFFF;
	padding: 10px;
	border-radius: 5px;
	gridline-color: #E5E7EB;
    outline: none;
}
QTableWidget::item{
	border-color: #E5E7EB;
	padding-left: 5px;
	padding-right: 5px;
	gridline-color: #E5E7EB;
}
QTableWidget::item:selected{
	background-color: #B8D4F0;
    color: #1a1a2e;
}
QHeaderView::section{
	background-color: #F5F7FA;
	max-width: 30px;
	border: none;
	border-style: none;
}
QTableWidget::horizontalHeader {	
	background-color: #F5F7FA;
}
QHeaderView::section:horizontal
{
    border: 1px solid #E5E7EB;
	background-color: #F5F7FA;
	padding: 3px;
	border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    color: #555555;
}
QHeaderView::section:vertical
{
    border: 1px solid #E5E7EB;
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
LineEdit */
QLineEdit {
	background-color: #FFFFFF;
	border-radius: 5px;
	border: 1px solid #D1D5DB;
	padding-left: 10px;
	selection-color: #FFFFFF;
	selection-background-color: #0078d4;
    color: #333333;
}
QLineEdit:hover {
	border: 1px solid #9CA3AF;
}
QLineEdit:focus {
	border: 1px solid #0078d4;
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
PlainTextEdit */
QPlainTextEdit {
	background-color: #FFFFFF;
	border-radius: 5px;
	padding: 10px;
	selection-color: #FFFFFF;
	selection-background-color: #0078d4;
    color: #333333;
}
QPlainTextEdit  QScrollBar:vertical {
    width: 8px;
 }
QPlainTextEdit  QScrollBar:horizontal {
    height: 8px;
 }
QPlainTextEdit:hover {
	border: 1px solid #9CA3AF;
}
QPlainTextEdit:focus {
	border: 1px solid #0078d4;
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
ScrollBars */
QScrollBar:horizontal {
    border: none;
    background: #F0F2F5;
    height: 8px;
    margin: 0px 21px 0 21px;
	border-radius: 0px;
}
QScrollBar::handle:horizontal {
    background: #C4C9D4;
    min-width: 25px;
	border-radius: 4px
}
QScrollBar::add-line:horizontal {
    border: none;
    background: #F0F2F5;
    width: 20px;
	border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    subcontrol-position: right;
    subcontrol-origin: margin;
}
QScrollBar::sub-line:horizontal {
    border: none;
    background: #F0F2F5;
    width: 20px;
	border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}
QScrollBar::up-arrow:horizontal, QScrollBar::down-arrow:horizontal
{
     background: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal
{
     background: none;
}
 QScrollBar:vertical {
	border: none;
    background-color: #F0F2F5;
    width: 8px;
    margin: 21px 0 21px 0;
	border-radius: 0px;
 }
 QScrollBar::handle:vertical {	
	background: #C4C9D4;
    min-height: 25px;
	border-radius: 4px
 }
 QScrollBar::add-line:vertical {
     border: none;
    background: #F0F2F5;
     height: 20px;
	border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
     subcontrol-position: bottom;
     subcontrol-origin: margin;
 }
 QScrollBar::sub-line:vertical {
	border: none;
    background: #F0F2F5;
     height: 20px;
	border-top-left-radius: 4px;
    border-top-right-radius: 4px;
     subcontrol-position: top;
     subcontrol-origin: margin;
 }
 QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
     background: none;
 }

 QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
     background: none;
 }

/* /////////////////////////////////////////////////////////////////////////////////////////////////
RadioButton */
QRadioButton::indicator {
    border: 2px solid #D1D5DB;
	width: 15px;
	height: 15px;
	border-radius: 10px;
    background: #FFFFFF;
}
QRadioButton::indicator:hover {
    border: 2px solid #0078d4;
}
QRadioButton::indicator:checked {
    background: #0078d4;
	border: 2px solid #0078d4;	
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
ComboBox */
QComboBox{
	background-color: #FFFFFF;
	border-radius: 5px;
	border: 1px solid #D1D5DB;
	padding: 5px;
	padding-left: 10px;
    color: #333333;
}
QComboBox:hover{
	border: 1px solid #b8d9ff;
}
QComboBox::drop-down {
	subcontrol-origin: padding;
	subcontrol-position: top right;
	width: 25px; 
	border-left-width: 1px;
	border-left-color: #b8d9ff;
	border-left-style: solid;
	border-top-right-radius: 3px;
	border-bottom-right-radius: 3px;
	background-color: #eef6ff;
	background-image: url(:/icons/images/icons/cil-arrow-bottom.png);
	background-position: center;
	background-repeat: no-repeat;
 }
QComboBox::drop-down:hover {
	background-color: #dff0ff;
	border-left-color: #4aa3ff;
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
Sliders */
QSlider::groove:horizontal {
    border-radius: 5px;
    height: 10px;
	margin: 0px;
	background-color: #E5E7EB;
}
QSlider::groove:horizontal:hover {
	background-color: #D1D5DB;
}
QSlider::handle:horizontal {
    background-color: #0078d4;
    border: none;
    height: 10px;
    width: 10px;
    margin: 0px;
	border-radius: 5px;
}
QSlider::handle:horizontal:hover {
    background-color: #106EBE;
}
QSlider::handle:horizontal:pressed {
    background-color: #005A9E;
}

QSlider::groove:vertical {
    border-radius: 5px;
    width: 10px;
    margin: 0px;
	background-color: #E5E7EB;
}
QSlider::groove:vertical:hover {
	background-color: #D1D5DB;
}
QSlider::handle:vertical {
    background-color: #0078d4;
	border: none;
    height: 10px;
    width: 10px;
    margin: 0px;
	border-radius: 5px;
}
QSlider::handle:vertical:hover {
    background-color: #106EBE;
}
QSlider::handle:vertical:pressed {
    background-color: #005A9E;
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
CommandLinkButton */
#pagesContainer QCommandLinkButton {	
	color: #0078d4;
	border-radius: 5px;
	padding: 5px;
    border: 1px solid #D1D5DB;
}
#pagesContainer QCommandLinkButton:hover {	
	color: #FFFFFF;
	background-color: #0078d4;
    border: 1px solid #0078d4;
}
#pagesContainer QCommandLinkButton:pressed {	
	color: #FFFFFF;
	background-color: #005A9E;
    border: 1px solid #005A9E;
}

/* /////////////////////////////////////////////////////////////////////////////////////////////////
Button */
#pagesContainer QPushButton {
	border: 1px solid #0078d4;
	border-radius: 5px;	
	background-color: #0078d4;
    color: #FFFFFF;
}
#pagesContainer QPushButton:hover {
	background-color: #106EBE;
	border: 1px solid #106EBE;
}
#pagesContainer QPushButton:pressed {	
	background-color: #005A9E;
	border: 1px solid #005A9E;
}
