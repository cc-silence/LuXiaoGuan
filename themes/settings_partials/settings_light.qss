/* 设置窗口专用样式：亮色兜底主题 */

QDialog {
	background-color: transparent;
	color: rgb(35, 39, 46);
	font: 10pt "Microsoft YaHei", "Segoe UI";
}

QToolTip {
	font: 11pt "Microsoft YaHei", "Segoe UI";
	color: #172033;
	background-color: #ffffff;
	border: 1px solid #c5cfde;
	border-radius: 4px;
	padding: 0;
	margin: 0;
}

#settingsWindowFrame {
	background-color: rgb(245, 246, 250);
	border: 1px solid #cfd8e3;
	border-radius: 8px;
}

#settingsTitleBar {
	background-color: #FFFFFF;
	border-bottom: 1px solid #E5E7EB;
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
}

#settingsWindowTitle {
	background-color: transparent;
	border: none;
	color: #333333;
	font: 10pt "Microsoft YaHei", "Segoe UI Semibold";
}

#settingsTitleButtons {
	background-color: transparent;
	border: none;
}

#settingsTitleButtons QPushButton#settingsCloseBtn {
	background-color: transparent;
	background-image: none;
	background-position: center;
	background-repeat: no-repeat;
	border: none;
	border-radius: 5px;
	padding: 0px;
	margin: 0px;
	min-width: 28px;
	max-width: 28px;
	min-height: 28px;
	max-height: 28px;
}

#settingsTitleButtons QPushButton#settingsCloseBtn:hover {
	background-color: #F0F2F5;
	background-image: none;
	background-position: center;
	background-repeat: no-repeat;
	border: none;
	border-radius: 4px;
}

#settingsTitleButtons QPushButton#settingsCloseBtn:pressed {
	background-color: #E5E7EB;
	background-image: none;
	background-position: center;
	background-repeat: no-repeat;
	border: none;
	border-radius: 4px;
}

#settingsCategoryPanel {
	/* 导航列比内容区略亮，并以细线明确一级导航和右侧内容的边界。 */
	background-color: #ffffff;
	border: none;
	border-right: 1px solid #e5e9ef;
	border-top-left-radius: 7px;
	border-bottom-left-radius: 7px;
}

/* 右侧页脚与导航列共同构成窗口底部；仅右下角保留外框圆角。 */
QFrame#settingsButtonPanel {
	background-color: #f5f6fa;
	border: none;
	border-bottom-right-radius: 7px;
}

QPushButton {
	min-height: 30px;
	padding: 6px 12px;
	border: 2px solid rgb(238, 241, 247);
	border-radius: 5px;
	background-color: rgb(210, 216, 230);
	color: rgb(35, 39, 46);
	text-align: left;
}

QPushButton:hover {
	background-color: rgb(198, 205, 222);
	border: 2px solid rgb(238, 241, 247);
}

QPushButton:checked {
	border-left: 4px solid rgb(0, 120, 212);
	background-color: rgb(225, 229, 238);
}

/* 分组标题：参考图 'Menu' 风格，小字灰色，无背景 */
QLabel#settingsCategoryTitle {
    color: #252a31;
    font: 11pt "Microsoft YaHei", "Segoe UI Semibold";
    padding: 4px 0 12px 0;
    background-color: transparent;
    border: none;
}

QLabel#settingsCategorySectionTitle {
    color: #5c5c5c;
    font: 9pt "Microsoft YaHei", "Segoe UI";
    padding: 10px 0 6px 0;
    background-color: transparent;
    border: none;
}

/* 分类按钮：未选中无背景，选中圆角矩形高亮 */
QPushButton#settingsCategoryButton {
    min-height: 32px;
    /* 六字导航名称需与 16px 图标共用 130px 侧栏，右侧不保留无效空白。 */
    padding: 5px 0 5px 6px;
    border: none;
    border-radius: 4px;
    background-color: transparent;
    color: #505050;
    text-align: left;
    font: 10pt "Microsoft YaHei", "Segoe UI";
    font-weight: normal;
}

QPushButton#settingsCategoryButton:hover {
    background-color: #f7f7f7;
    border: 1px solid #0078d4;
    color: #202020;
}

QPushButton#settingsCategoryButton:checked {
    background-color: #e8edf3;
    color: #1c3146;
    font: 10pt "Microsoft YaHei", "Segoe UI Semibold";
}

#settingsOkBtn,
#settingsCancelBtn,
QPushButton#settingsPrimaryButton,
QPushButton#settingsSecondaryButton,
QPushButton#settingsToolbarButton,
QPushButton#settingsDangerButton {
	min-height: 28px;
	padding: 0px 12px;
	text-align: center;
}

#settingsOkBtn,
QPushButton#settingsPrimaryButton,
QPushButton#settingsToolbarButton {
	background-color: #eef6ff;
	border: 1px solid #b8d9ff;
	color: #172033;
}

#settingsOkBtn:hover,
QPushButton#settingsPrimaryButton:hover,
QPushButton#settingsToolbarButton:hover {
	background-color: #dff0ff;
	border: 1px solid #4aa3ff;
}

#settingsOkBtn:pressed,
QPushButton#settingsPrimaryButton:pressed,
QPushButton#settingsToolbarButton:pressed {
	background-color: #c8e7ff;
	border: 1px solid #1687e0;
	color: #0f3155;
}

#settingsCancelBtn,
QPushButton#settingsSecondaryButton {
	background-color: #eef1f5;
	border: 1px solid #d3d9e3;
	color: #333333;
}

#settingsCancelBtn:hover,
QPushButton#settingsSecondaryButton:hover {
	background-color: #e3e8ef;
	border: 1px solid #b8c3d1;
}

QPushButton#settingsMergeButton,
QPushButton#settingsSecondaryButton[updateActionReady="true"]:enabled {
	min-height: 28px;
	padding: 0px 12px;
	text-align: center;
	background-color: #e8f7ef;
	border: 1px solid #26a269;
	color: #0e5c35;
}

QPushButton#settingsMergeButton:hover,
QPushButton#settingsSecondaryButton[updateActionReady="true"]:enabled:hover {
	background-color: #d6f0e1;
	border: 1px solid #07884d;
	color: #064c28;
}

QPushButton#settingsMergeButton:pressed,
QPushButton#settingsSecondaryButton[updateActionReady="true"]:enabled:pressed {
	background-color: #c2e8d1;
	border: 1px solid #06743f;
}

QPushButton#settingsMergeButton:focus,
QPushButton#settingsSecondaryButton[updateActionReady="true"]:enabled:focus {
	border: 1px solid #07884d;
}

QPushButton#settingsDangerButton {
	background-color: #fff1f2;
	border: 1px solid #f4b4bd;
	color: #8a1f2d;
}

QPushButton#settingsDangerButton:hover {
	background-color: #ffe1e5;
	border: 1px solid #e36b7a;
}

QPushButton#settingsDangerButton:pressed {
	background-color: #ffd1d8;
	border: 1px solid #c92d42;
}

#settingsOkBtn:focus,
QPushButton#settingsPrimaryButton:focus,
QPushButton#settingsSecondaryButton:focus,
QPushButton#settingsToolbarButton:focus,
QPushButton#settingsDangerButton:focus {
	outline: none;
}

#settingsOkBtn:disabled,
#settingsCancelBtn:disabled,
QPushButton#settingsPrimaryButton:disabled,
QPushButton#settingsSecondaryButton:disabled,
QPushButton#settingsToolbarButton:disabled,
QPushButton#settingsDangerButton:disabled {
	background-color: #eef1f5;
	border: 1px solid #d3d9e3;
	color: #9aa4b2;
}

QToolButton#settingsToolButton {
	min-width: 28px;
	max-width: 28px;
	min-height: 28px;
	max-height: 28px;
	padding: 0px;
	border: 1px solid #b8d9ff;
	border-radius: 5px;
	background-color: #eef6ff;
	color: #172033;
	text-align: center;
}

QToolButton#settingsToolButton:hover {
	background-color: #dff0ff;
	border: 1px solid #4aa3ff;
}

QToolButton#settingsToolButton:pressed {
	background-color: #c8e7ff;
	border: 1px solid #1687e0;
	color: #0f3155;
}

QToolButton#settingsTreeActionButton {
	min-width: 34px;
	max-width: 34px;
	min-height: 34px;
	max-height: 34px;
	padding: 0px;
	border: 1px solid #b8d9ff;
	border-radius: 5px;
	background-color: #eef6ff;
	color: #172033;
	text-align: center;
}

QToolButton#settingsTreeActionButton:hover {
	background-color: #dff0ff;
	border: 1px solid #4aa3ff;
}

QToolButton#settingsTreeActionButton:pressed {
	background-color: #c8e7ff;
	border: 1px solid #1687e0;
	color: #0f3155;
}

QFrame#settingsCollapsibleSection {
    background-color: transparent;
    border: none;
}

QPushButton#settingsCollapseHeader {
    min-height: 36px;
    padding: 0px;
    border: none;
    border-radius: 4px;
    background-color: transparent;
    color: rgb(35, 39, 46);
    text-align: left;
    font: 10pt "Microsoft YaHei", "Segoe UI";
}

QPushButton#settingsCollapseHeader:hover {
    background-color: transparent;
    border: none;
}

QPushButton#settingsCollapseHeader:checked {
    background-color: transparent;
}

QPushButton#settingsCollapseHeader:focus {
    background-color: transparent;
    border: none;
}

QFrame#settingsCollapseContent {
    background-color: transparent;
    border: none;
}

QLabel#settingsCollapseArrow {
	color: rgb(35, 39, 46);
	font: 10pt "Microsoft YaHei", "Segoe UI Semibold";
	background-color: transparent;
}

QLabel#settingsCollapseTitle {
	color: rgb(24, 28, 36);
	font: 12pt "Microsoft YaHei", "Segoe UI Semibold";
	background-color: transparent;
	font-weight: 600;
}

QLabel#settingsCollapseDescription {
	color: rgb(95, 105, 125);
	font: 9pt "Microsoft YaHei", "Segoe UI";
	background-color: transparent;
}

QLabel#settingsSubTitle {
	color: #0078d4;
	font: 10pt "Microsoft YaHei", "Segoe UI Semibold";
	background-color: transparent;
}

QFrame#settingsActionPanel {
	background-color: transparent;
	border: none;
}

QFrame#settingsContentPanel {
	background-color: rgb(236, 239, 246);
	border: 1px solid rgb(198, 205, 222);
	border-radius: 4px;
}

QFrame#settingsContentPanel QScrollArea {
	background-color: transparent;
	border: none;
}

/* 常用设置网格为避免列数跳动会预留自动隐藏滚动条槽位，槽位背景必须与网格面板一致。 */
QScrollArea#quickSettingsGridScrollArea,
QScrollArea#quickSettingsGridScrollArea::viewport {
	background-color: rgb(236, 239, 246);
}

QScrollArea#quickSettingsGridScrollArea QScrollBar#autoHideScrollBar:vertical,
QScrollArea#quickSettingsGridScrollArea QScrollBar#autoHideScrollBar::add-page:vertical,
QScrollArea#quickSettingsGridScrollArea QScrollBar#autoHideScrollBar::sub-page:vertical {
	background-color: rgb(236, 239, 246);
}

QFrame#settingsInlineStack,
QFrame#settingsInlinePage {
	background-color: transparent;
	border: none;
}

QPushButton#iconPickerButton,
QPushButton#iconPreviewButton {
	text-align: center;
	padding: 0px;
	border: 1px solid rgb(198, 205, 222);
	border-radius: 5px;
	background-color: rgb(225, 229, 238);
}

QPushButton#iconPickerButton:hover,
QPushButton#iconPickerButton:checked {
	border: 2px solid #0078d4;
	background-color: rgb(210, 216, 230);
}

QTabBar#proxyTabBar::tab {
	background-color: #eef1f5;
	color: #555;
	border: 1px solid #d3d9e3;
	border-top-left-radius: 5px;
	border-top-right-radius: 5px;
	padding: 4px 14px;
	min-height: 24px;
}

QTabBar#proxyTabBar::tab:selected {
	background-color: #f5f6fa;
	color: #0078d4;
	border-bottom: 2px solid #f5f6fa;
}

QTabBar#proxyTabBar::tab:hover:!selected {
	background-color: #dff0ff;
	border: 1px solid #4aa3ff;
}

QFrame#settingsSeparator {
	background-color: rgb(238, 241, 247);
	min-height: 2px;
	max-height: 2px;
	border: none;
}

QLineEdit,
QComboBox,
QTextEdit,
QTreeWidget#settingsListPanel {
	min-height: 28px;
	padding-left: 8px;
	border-radius: 5px;
	border: 1px solid rgb(198, 205, 222);
	background-color: rgb(245, 246, 250);
	color: rgb(35, 39, 46);
}

/* 设置弹窗内的输入控件统一使用页面底色，避免被主窗口 light.qss 的白色输入框规则覆盖。 */
#settingsWindowFrame QLineEdit,
#settingsWindowFrame QComboBox,
#settingsWindowFrame QTextEdit,
#settingsWindowFrame QTreeWidget#settingsListPanel {
	background-color: rgb(245, 246, 250);
	border: 1px solid rgb(198, 205, 222);
	color: rgb(35, 39, 46);
}

QTextEdit {
	padding: 8px;
}
QTreeWidget#settingsListPanel {
	padding: 0;
}

QTextEdit#settingsMessageText {
	background-color: rgb(245, 246, 250);
	border: 1px solid rgb(198, 205, 222);
	border-radius: 6px;
	color: rgb(35, 39, 46);
	padding: 10px;
}

QTreeWidget#softwareItemsTree {
	padding: 6px;
	outline: none;
	border: 1px solid rgb(198, 205, 222);
	border-radius: 4px;
	background-color: rgb(236, 239, 246);
	color: rgb(35, 39, 46);
	selection-background-color: #90b8d8;
	selection-color: rgb(20, 24, 30);
}

QTreeWidget#softwareItemsTree::item {
	min-height: 28px;
	padding: 3px 6px;
	border-radius: 0px;
}

QTreeWidget#softwareItemsTree::item:hover {
	background-color: rgb(222, 228, 238);
}

QTreeWidget#softwareItemsTree::item:selected {
	background-color: #90b8d8;
	color: rgb(20, 24, 30);
}

QListWidget#settingsListPanel {
	padding: 6px;
	outline: none;
	border: 1px solid rgb(198, 205, 222);
	border-radius: 4px;
	background-color: rgb(236, 239, 246);
	color: rgb(35, 39, 46);
	selection-background-color: #90b8d8;
	selection-color: rgb(20, 24, 30);
}

QListWidget#settingsListPanel::item {
	min-height: 28px;
	padding: 3px 6px;
	border-radius: 0px;
}

QListWidget#settingsListPanel::item:hover {
	background-color: rgb(222, 228, 238);
}

QListWidget#settingsListPanel::item:selected {
	background-color: #90b8d8;
	color: rgb(20, 24, 30);
}

QMenu {
	background-color: rgb(245, 246, 250);
	color: rgb(35, 39, 46);
	border: 1px solid rgb(238, 241, 247);
	padding: 6px;
}

QMenu::item {
	padding: 6px 24px;
}

QMenu::item:selected {
	background-color: rgb(0, 120, 212);
	color: rgb(255, 255, 255);
}

QTextEdit#settingsCodeInput {
	font-family: "Consolas", "Courier New";
	letter-spacing: 0px;
}

QLineEdit:disabled,
QLineEdit#proxyInput:disabled,
QLineEdit#pathInput:disabled,
QLineEdit#settingsProxyInput:disabled,
QLineEdit#settingsPathInput:disabled,
QLineEdit#settingsNameInput:disabled,
QTextEdit#settingsCodeInput:disabled,
QTextEdit:disabled {
	background-color: rgb(221, 225, 234);
	border: 2px solid rgb(238, 241, 247);
	color: rgb(95, 105, 125);
}


QComboBox {
	padding: 5px;
	padding-left: 10px;
}

QComboBox:hover {
	border: 2px solid #b8d9ff;
}

QComboBox::drop-down {
	subcontrol-origin: padding;
	subcontrol-position: top right;
	width: 25px;
	border-left-width: 1px;
	border-left-color: #b8d9ff;
	border-left-style: solid;
	border-top-right-radius: 3px;
	border-bottom-right-radius: 3px;
	background-color: #eef6ff;
	background-image: url(:/icons/images/icons/cil-arrow-bottom.png);
	background-position: center;
	background-repeat: no-repeat;
}

QComboBox::drop-down:hover {
	background-color: #dff0ff;
	border-left-color: #4aa3ff;
}


QCheckBox,
QRadioButton {
	color: rgb(35, 39, 46);
	spacing: 8px;
}

QRadioButton::indicator {
    border: 2px solid #aeb7c2;
	width: 15px;
	height: 15px;
	border-radius: 9px;
    background: #ffffff;
}

QRadioButton::indicator:hover {
    border: 2px solid #7f8b99;
}

QRadioButton::indicator:checked {
	background: #8fc5ee;
	border: 2px solid #7eaed2;
}

QSlider::groove:horizontal {
	border-radius: 5px;
	height: 10px;
	margin: 0px;
	background-color: rgb(210, 216, 230);
}

QSlider::groove:horizontal:hover {
	background-color: rgb(198, 205, 222);
}

QSlider::handle:horizontal {
	background-color: #0078d4;
	border: none;
	height: 14px;
	width: 14px;
	margin: -2px 0px;
	border-radius: 7px;
}

QSlider::handle:horizontal:hover {
	background-color: rgb(195, 155, 255);
}

QSlider::handle:horizontal:pressed {
	background-color: #0078d4;
}

QSlider::sub-page:horizontal {
	background-color: #0078d4;
	border-radius: 4px;
}

QLabel {
	color: rgb(35, 39, 46);
	background-color: transparent;
}

QScrollArea {
	background-color: rgb(245, 246, 250);
	border: none;
}

QScrollArea QWidget {
	background-color: rgb(245, 246, 250);
}

QScrollBar:vertical {
	background-color: rgb(225, 229, 238);
	width: 10px;
	margin: 0px;
	border: none;
	border-radius: 5px;
}

QScrollBar::handle:vertical {
	background-color: rgb(113, 126, 149);
	min-height: 36px;
	border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
	background-color: #0078d4;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
	height: 0px;
	background: transparent;
	border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
	background: transparent;
}

QScrollBar:horizontal {
	background-color: rgb(225, 229, 238);
	height: 10px;
	margin: 0px;
	border: none;
	border-radius: 5px;
}

QScrollBar::handle:horizontal {
	background-color: rgb(113, 126, 149);
	min-width: 36px;
	border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
	background-color: #0078d4;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
	width: 0px;
	background: transparent;
	border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
	background: transparent;
}

QScrollBar#autoHideScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
    border: none;
}
QScrollBar#autoHideScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
    border: none;
}
QScrollBar#autoHideScrollBar::handle:vertical,
QScrollBar#autoHideScrollBar::handle:horizontal {
    background: #718095;
    border-radius: 4px;
}
QScrollBar#autoHideScrollBar::handle:vertical:hover,
QScrollBar#autoHideScrollBar::handle:horizontal:hover {
    background: #0078d4;
}
QScrollBar#autoHideScrollBar::add-page:vertical,
QScrollBar#autoHideScrollBar::sub-page:vertical,
QScrollBar#autoHideScrollBar::add-page:horizontal,
QScrollBar#autoHideScrollBar::sub-page:horizontal {
    background: transparent;
    border: none;
}
QScrollBar#autoHideScrollBar::add-line:vertical,
QScrollBar#autoHideScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: transparent;
}
QScrollBar#autoHideScrollBar::add-line:horizontal,
QScrollBar#autoHideScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
    background: transparent;
}

/* 必须放在通用 QScrollArea 规则之后，覆盖预留滚动条槽位的白色背景。 */
QScrollArea#quickSettingsGridScrollArea,
QScrollArea#quickSettingsGridScrollArea::viewport,
QScrollArea#quickSettingsGridScrollArea QWidget,
QScrollArea#quickSettingsGridScrollArea QScrollBar#autoHideScrollBar:vertical,
QScrollArea#quickSettingsGridScrollArea QScrollBar#autoHideScrollBar::add-page:vertical,
QScrollArea#quickSettingsGridScrollArea QScrollBar#autoHideScrollBar::sub-page:vertical {
    background-color: rgb(236, 239, 246);
}

QGroupBox {
	border: none;
	background-color: rgb(245, 246, 250);
}

QFrame#settingsPage {
	border: none;
	background: transparent;
}

QLabel#settingsTitle,
QLabel#settingsPageTitle {
	font: 14pt "Microsoft YaHei", "Segoe UI Semibold";
	color: rgb(0, 120, 212);
}

QLabel#settingsSectionTitle {
	font: 11pt "Microsoft YaHei", "Segoe UI Semibold";
	color: rgb(24, 28, 36);
}

QLabel#settingsHint {
	color: rgb(95, 105, 125);
}

QLabel#settingsWarning {
	color: rgb(174, 82, 0);
	background-color: rgba(174, 82, 0, 0.08);
	border: 1px solid rgb(174, 82, 0);
	border-radius: 4px;
	padding: 8px 12px;
}

QTextBrowser#scriptHelpBrowser {
	background: transparent;
	border: none;
	color: rgb(35, 39, 46);
	font: 9.5pt "Microsoft YaHei", "Segoe UI";
	padding: 12px 16px;
}

/* 快速设置窗口 */
#quickSettingsWindow {
	background-color: rgb(245, 246, 250);
	border: 1px solid #cfd8e3;
	border-radius: 8px;
}

/* 快速设置网格卡片（设置页预览） */
QFrame#quickSettingsGridItem {
	background-color: transparent;
	border: none;
	border-radius: 8px;
}

QFrame#quickSettingsGridItem:hover {
	background-color: transparent;
	border: 1px solid #0078d4;
}

QLabel#quickSettingsGridIcon,
QLabel#quickSettingsGridName {
	color: rgb(35, 39, 46);
	background-color: transparent;
	font: 9pt "Microsoft YaHei", "Segoe UI";
}

QFrame#quickSettingsSeparatorGridItem {
    background-color: transparent;
    border: none;
}

QLabel#quickSettingsSeparatorLabel {
    color: #5d6b7d;
    background-color: transparent;
    font: 9pt "Microsoft YaHei", "Segoe UI";
}

QFrame#quickSettingsSeparatorLine {
    min-height: 1px;
    max-height: 1px;
    background-color: #aebbd0;
    border: none;
}

QFrame#quickSettingsDropIndicator {
	background-color: #0078d4;
	border: none;
	border-radius: 1px;
}

/* 常用文件开始菜单式分组网格 */
QFrame#groupedLauncherItemTile,
QFrame#groupedLauncherGroupTile {
    background-color: transparent;
    border: none;
    border-radius: 6px;
}

QFrame#groupedLauncherItemTile:hover,
QFrame#groupedLauncherGroupTile:hover {
    background-color: transparent;
    border: 1px solid #0078d4;
}

QFrame#groupedLauncherGroupPreview {
    background-color: #e6edf5;
    border: 1px solid #c5d0de;
    border-radius: 4px;
}

QLabel#groupedLauncherItemName {
    color: rgb(35, 39, 46);
    background-color: transparent;
    font: 9pt "Microsoft YaHei", "Segoe UI";
}

QFrame#groupedLauncherDropTarget {
    background-color: rgba(0, 120, 212, 0.14);
    border: 1px solid #0078d4;
    border-radius: 6px;
}

QKeySequenceEdit {
    background-color: #ffffff;
    color: rgb(35, 39, 46);
    border: 1px solid #aebbd0;
    border-radius: 4px;
    min-height: 28px;
    padding: 0 8px;
}

QKeySequenceEdit:focus { border-color: #0078d4; }

/* 设置页内部子页面导航：仅用底部指示线表达切换，不伪装成工具栏按钮 */
QFrame#settingsSubpageNavigation {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #c8d3e0;
}

QPushButton#settingsSubpageNavTab {
    background-color: transparent;
    color: #5a687a;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 5px 5px 0 0;
    font: 9pt "Microsoft YaHei", "Segoe UI";
    padding: 0 12px;
    text-align: center;
}

QPushButton#settingsSubpageNavTab:hover {
    color: #1d5f96;
    background-color: #edf5fb;
}

QPushButton#settingsSubpageNavTab:checked {
    color: #0078d4;
    border-bottom-color: #0078d4;
    background-color: #edf5fb;
    font-weight: 600;
}

QRadioButton#settingsSubpageNavTab {
    background-color: transparent;
    color: #5a687a;
    border: none;
    border-radius: 0;
    font: 10.5pt "Microsoft YaHei", "Segoe UI";
    padding: 0 12px;
    spacing: 8px;
}

QRadioButton#settingsSubpageNavTab:hover { color: #1d5f96; }
QRadioButton#settingsSubpageNavTab:checked {
    color: #0078d4;
    background-color: #e9f4fc;
    border: 1px solid #a7d3ee;
    border-radius: 5px;
    font-weight: 600;
}
QRadioButton#settingsSubpageNavTab::indicator { width: 8px; height: 8px; border: none; border-radius: 4px; background-color: transparent; }
QRadioButton#settingsSubpageNavTab::indicator:checked { background-color: #27b87a; }

/* 快速设置按钮（主界面窗口） */
QPushButton#quickSettingsButton {
	background-color: rgb(225, 229, 238);
	border: 1px solid rgb(198, 205, 222);
	border-radius: 6px;
	color: rgb(35, 39, 46);
	text-align: center;
	padding: 4px;
}

QPushButton#quickSettingsButton:hover {
	background-color: rgb(210, 216, 230);
	border: 1px solid #4aa3ff;
}

QPushButton#quickSettingsButton:pressed {
	background-color: #c8e7ff;
	border: 1px solid #1687e0;
	color: #0f3155;
}

QPushButton#quickSettingsButton:disabled {
	background-color: #eef1f5;
	border: 1px solid #d3d9e3;
	color: #9aa4b2;
}

/* 快速设置添加按钮 */
QPushButton#quickSettingsAddButton {
	background-color: rgb(236, 239, 246);
	border: 2px dashed #b8c3d1;
	border-radius: 6px;
	color: #717e95;
	font: 20pt "Microsoft YaHei", "Segoe UI";
	text-align: center;
}

QPushButton#quickSettingsAddButton:hover {
	background-color: rgb(225, 229, 238);
	border: 2px dashed #8899ad;
	color: #333333;
}

/* 标题栏快速设置按钮 */
QPushButton#quickSettingsTopBtn {
	background-color: rgb(225, 229, 238);
	border: 1px solid rgb(198, 205, 222);
	border-radius: 5px;
	color: rgb(35, 39, 46);
	padding: 4px 12px;
	min-height: 24px;
	max-height: 28px;
	font: 9pt "Microsoft YaHei", "Segoe UI";
}

QPushButton#quickSettingsTopBtn:hover {
	background-color: rgb(210, 216, 230);
	border: 1px solid #4aa3ff;
}

QPushButton#quickSettingsTopBtn:pressed {
	background-color: #c8e7ff;
	border: 1px solid #1687e0;
	color: #0f3155;
}

QToolButton#quickSettingsLayoutSelector {
    background-color: rgb(225, 229, 238);
    border: 1px solid rgb(198, 205, 222);
    border-radius: 6px;
    min-width: 42px;
    max-width: 42px;
    min-height: 34px;
    max-height: 34px;
    padding: 3px;
}

QToolButton#quickSettingsLayoutSelector:hover {
    background-color: rgb(210, 216, 230);
    border: 1px solid #0078d4;
}

QFrame#quickSettingsLayoutPopup {
    background-color: rgb(245, 246, 250);
    border: 1px solid rgb(198, 205, 222);
    border-radius: 7px;
}

QFrame#quickSettingsLayoutOption {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
}

QFrame#quickSettingsLayoutOption:hover,
QFrame#quickSettingsLayoutOption[selected="true"] {
    background-color: rgb(225, 229, 238);
    border: 1px solid #0078d4;
}

QLabel#quickSettingsLayoutLabel,
QFrame#quickSettingsLayoutPreview {
    color: rgb(35, 39, 46);
    background-color: transparent;
    border: none;
}

QToolButton#quickSettingsButton {
    background-color: rgb(225, 229, 238);
    border: 1px solid rgb(198, 205, 222);
    border-radius: 6px;
    color: rgb(35, 39, 46);
    padding: 4px;
}

QToolButton#quickSettingsButton:hover {
    background-color: rgb(210, 216, 230);
    border: 1px solid #0078d4;
}

QToolButton#quickSettingsButton:pressed {
    background-color: #c8e7ff;
    border: 1px solid #1687e0;
    color: #0f3155;
}

#settingsTitleButtons QPushButton[windowControl="true"] {
 background-color: transparent; background-image: none; border: none;
 border-radius: 5px; padding: 0; margin: 0;
 min-width: 28px; max-width: 28px; min-height: 28px; max-height: 28px;
}
#settingsTitleButtons QPushButton[windowControl="true"]:hover { background-color: #e2e8f0; }
#settingsTitleButtons QPushButton[windowControl="true"]:pressed { background-color: #d6e0ed; }

QTextEdit#settingsMessageText[connectionWarning="true"] {
    font-size: 10pt;
}

/* Title controls must not inherit left alignment from content buttons. */
#settingsTitleButtons QPushButton[windowControl="true"],
#settingsTitleButtons QPushButton#settingsCloseBtn { text-align: center; }

/* Shared field validation; layout and normal styling stay unchanged. */
QLineEdit[inputError="true"], QLineEdit[inputError="true"]:focus,
#settingsWindowFrame QLineEdit[inputError="true"],
#settingsWindowFrame QLineEdit[inputError="true"]:focus {
    border-color: #c62828;
}
