  "followup_20261113": {
    "scope": "AP country recommendation uses existing country request and validation path; official OpenWrt review applies. Navigation and collapse coordinate checks are local UI only.",
    "navigation": "Root cause: QSS content height plus margins disagreed with fixed outer height. Fresh startup page switch and subsequent refresh keep navigation coordinates at 100/125/150/175 percent.",
    "collapse": {
      "root_cause": "During overlapping animations, scroll content retained a previous smaller height while its layout had already grown. Ordinary QVBoxLayout could compress preceding items for a frame: profile y218 -> y200 -> y218, or y218 -> y156 -> y218. Primary card minimum height was still 192, causing overlap rather than legitimate resize.",
      "fix": "Reuse NaturalHeightVBoxLayout and SetMinimumSize in the shared setup dialog. The content minimum grows before child arrangement, without timers, forced scroll positions or altered card styling. Applies to AP, relay and compact verification dialog.",
      "checks": "14 related tests pass, including 120 interrupted toggle operations in each AP/relay, dark/light, 100/175 percent combination. Original reproduction: zero coordinate changes in 160 toggles after repair. Native Windows painting checked separately.",
      "reference": "https://doc.qt.io/qt-6/qscrollarea.html#size-hints-and-layouts",
      "reference_read_date": "2026-11-13",
      "limitations": "No native Debian 12 desktop validation."
    },
