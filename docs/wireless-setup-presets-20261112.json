  "date": "2026-11-13",
  "scope": "AP and relay editor profile selection; no new router commands, package install, driver changes or automatic apply.",
  "defaults": "Existing profile remains default. Name/password, AP network membership, channel, transmit power and identity are preserved across profile switches. Recommended AP country selects TW only when advertised and supported; existing profile restores its original country selection.",
  "ap_recommendation": {
    "standard_width": "Existing capability-gated default_htmode: 2.4 GHz prefers 20 MHz; 5/6 GHz prefer 80/40/20 MHz when confirmed. Unknown bands are not guessed.",
    "security": "WPA2-PSK with optional PMF for confirmed 2/5 GHz; SAE with mandatory PMF only when 6 GHz and SAE support are confirmed.",
    "values": {
      "hidden": "0",
      "isolate": "1",
      "wmm": "1",
      "dtim_period": "2",
      "beacon_int": "100",
      "country": "TW, only when advertised and option_supported"
    },
    "scope": "Only individually confirmed options are submitted. Other advanced, identity and topology options stay unchanged. Country is radio-wide; no force-regdomain or transmit-power override is introduced."
  },
  "relay_recommendation": "Routed client, DHCP and automatically supplied DNS. Existing masquerading-enabled wan zone preferred if present; no zones are created, no static IP or device identity guessed. Other parameters remain unchanged.",
  "existing_flow": "Profile switching does no router I/O. Existing request validation, revision check, save-only/apply confirmation, management-link safety, rollback and startup verification are reused.",
  "checks": {
    "tests": 60,
    "visual": "Actual Windows Qt dialogs, both themes, 100/125/150/175% scaling, select-disabled while busy.",
    "native_save": "Real Lua interpreter with deterministic UCI fixture: recommended editor request confirmed. Existing password/txpower/channel retained; country remains CN in fixture without advertised TW. Editor request tests cover advertised TW selection and exact restoration.",
    "limitations": "No physical router or native Debian 12 verification; no firmware/hardware-wide success claim. Exact schema fixtures are synthetic, not device captures."
  },
