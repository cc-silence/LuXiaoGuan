{
  "date": "2026-11-05",
  "scope": "Online password verification; dedicated SSH automation terminal; no UI changes",
  "reason_for_router_compatibility_review": "Changing SSH PTY negotiation and grouping existing UCI/reload commands affects router execution. No driver or radio mapping changes.",
  "input_archive": "CC_LuXiaoGuan_抓包_20261105_124718.zip",
  "reference_script": {
    "filename": "crack_wifi_password.sh",
    "sha256": "6be7167269a8f06852630b185ba5cfbb06385b85cef03db85c6fad36ba45408d",
    "executed": false,
    "observations": [
      "Whole-round temporary configuration reuse and repeated success confirmation already exist in the application",
      "Fixed 11-second waits do not establish conclusive authentication failure",
      "Deleting existing wifi-iface profiles, persistent firewall modifications, hard-coded wlan/radio mapping, and plaintext console passwords were not adopted"
    ]
  },
  "evidence": {
    "pipe": "First target control ping timed out after approximately five seconds; exact raw reply is not retained, underlying pipe-only failure remains unconfirmed",
    "pty": "Exit code 126 matches the explicit failure branch after stty; OpenWrt 23.05.4 default BusyBox config excludes stty; missing applet versus failed settings cannot be distinguished from this log",
    "later_targets": "Same run subsequently used native control, including a successful authentication"
  },
  "fix": {
    "pty": "Negotiate RFC 4254 ICANON=0 and ECHO=0 in the SSH pty-req before executing wpa_cli; no stty dependency",
    "scope": "Only control channels use the new terminal modes; interactive user consoles and capture channels retain their settings",
    "dependency": "Small isolated adapter mirrors Paramiko 5.0 channel request/ack lifecycle because public get_pty has no terminal_modes argument; revisit this adapter on Paramiko upgrades",
    "fallback": "Still only before candidate submission; no retry of a submitted password; same cache flush and fresh-ID authentication requirements",
    "ownership": "Existing bounded owner handles channel rejection, timeout, cancellation and cleanup without closing the shared login"
  },
  "compatibility_optimization": {
    "environment": "Prepare UCI options in one SSH request and commit each configuration once, instead of duplicate early commits and one request per option",
    "sample_fixture": "19 setup operations in one request; setup/reload/ifup use 3 requests in total",
    "candidate": "Credential updates, commit and diff reload use one request instead of two, connected with success-only shell sequencing",
    "failure": "Parenthesized batch groups prevent a later local || true guard from hiding an earlier failure",
    "wait": "Do not sleep for two seconds after the fourteenth and last connection observation, including when an address only appears at that last observation",
    "unchanged": "Five-second post-reload settling wait, 14 observations, two-second observation intervals and three consecutive address confirmations; no IPv4 remains unknown, never a permanent wrong-key record",
    "expected_gain": "Less SSH and storage overhead plus two seconds saved for exhausted unconfirmed candidates; no measured router-wide speedup or promised multiplier"
  },
  "compatibility": {
    "exact_openwrt_release_makefiles_read": 50,
    "dropbear_versions": [
      "2019.78",
      "2020.81",
      "2022.82",
      "2024.86",
      "2025.89"
    ],
    "source_conclusion": "All five exact Dropbear implementations read SSH terminal modes and apply local flags with tcsetattr before command execution. This is SSH protocol behavior independent of radio chipset or CPU architecture. Firmware that refuses PTY requests remains subject to capability fallback. Source review does not establish device runtime support.",
