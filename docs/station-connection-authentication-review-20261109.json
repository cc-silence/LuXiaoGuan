{
  "date": "2026-11-09",
  "summary": "中继信号只有在认证完成且连接对象匹配时才显示连接成功。",
  "applicability": "Remote read-only wireless operation: official OpenWrt compatibility rules apply. No network configuration, package installation, driver replacement, reconnection, or new timer is introduced.",
  "root_cause": "A valid driver BSSID or a single association record previously became associated=True, and the card equated association with completed authentication.",
  "behavior": {
    "connected": "Supplicant wpa_state=COMPLETED, valid unicast authenticated BSSID, current configured SSID byte match, and configured BSSID match when locked. Driver iwinfo.info.bssid is not authoritative: some legacy drivers return the station own MAC there.",
    "connecting": "SCANNING/AUTHENTICATING/ASSOCIATING/ASSOCIATED/4WAY_HANDSHAKE/GROUP_HANDSHAKE do not report success.",
    "disconnected": "DISCONNECTED/INTERFACE_DISABLED/INACTIVE are explicit disconnected evidence, not a password-error verdict.",
    "unknown": "Missing tools, missing/invalid/oversized/duplicate response, timeout, unsupported capability or mismatched target never report success or wrong password.",
    "internet": "Internet checks remain independent; authentication not completed suppresses probing and reusing old Internet success. Connection state is part of cache identity.",
    "scope_limit": "Current authenticated session is proved at observation time; not permanent connectivity, Internet access, or independent validation of a saved but unapplied password."
  },
  "architecture": {
    "collector": "Current netifd interface ownership supplies the exact ifname. Read-only native wpa_supplicant bss_info is tried inside the existing Lua sample; only required fields are retained.",
    "fallback": "When native method is absent, wpa_cli -i <actual interface> status runs through the existing cancellable command runner. Native partial/contradictory evidence does not fall back to driver association.",
    "limits": "At most 64 runtime networks; status response <=8192 bytes; CLI request <=2 seconds and aggregate CLI budget <=4 seconds per sample; missing executable/timeout stops further CLI requests in that sample; no persistent new cache.",
    "privacy": "Only normalized connection state and established public signal identity enter the model. Raw authentication dictionaries and temporary matching fields are discarded. No password is read or submitted."
  },
